# WeChat Official Account API Configuration
WECHAT_APP_ID=your-app-id-here
WECHAT_APP_SECRET=your-app-secret-here

# Claude API Configuration (for content generation)
# Anthropic官方: https://api.anthropic.com/v1
# Claude Gateway: http://your-gateway:port/v1
ANTHROPIC_API_KEY=your-claude-api-key-here
CLAUDE_BASE_URL=https://api.anthropic.com/v1
CLAUDE_MODEL=claude-sonnet-4-6

# Embedding API Configuration (OpenAI标准协议，支持国产模型)
# OpenAI官方: https://api.openai.com/v1
# 阿里千问: https://dashscope.aliyuncs.com/compatible-mode/v1
# DeepSeek: https://api.deepseek.com/v1
# 其他国产模型: 填入对应的兼容地址
OPENAI_API_KEY=your-embedding-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# Server Configuration
FLASK_PORT=8080
FLASK_HOST=0.0.0.0
FLASK_DEBUG=false

# Database Path (optional, defaults to local)
# DB_PATH=/path/to/library.db

# Logging Level
LOG_LEVEL=INFO
