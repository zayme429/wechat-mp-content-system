# WeChat Official Account API Configuration
WECHAT_APP_ID=your-app-id-here
WECHAT_APP_SECRET=your-app-secret-here

# Kimi API Configuration (for content generation)
KIMI_API_KEY=your-kimi-api-key-here

# Server Configuration
FLASK_PORT=8080
FLASK_HOST=0.0.0.0
FLASK_DEBUG=false

# Database Path (optional, defaults to local)
# DB_PATH=/path/to/library.db

# Logging Level
LOG_LEVEL=INFO
