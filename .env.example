# WeChat Official Account API Configuration
WECHAT_APP_ID=your-app-id-here
WECHAT_APP_SECRET=your-app-secret-here

# LLM API Configuration (OpenAI-compatible /chat/completions)
# This system's text generation uses Moonshot/Kimi API by default.
# If you have a GPT gateway (OpenAI-compatible), set KIMI_BASE_URL to your gateway.
KIMI_API_KEY=your-kimi-or-moonshot-api-key
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=kimi-k2.5

# Backward-compatible aliases (some code reads these as fallback)
# You can ignore these if you set KIMI_*.
ANTHROPIC_API_KEY=your-claude-api-key-here
CLAUDE_BASE_URL=
CLAUDE_MODEL=

# Embedding API Configuration (OpenAI-compatible /embeddings)
# SiliconFlow example:
#   OPENAI_BASE_URL=https://api.siliconflow.cn/v1
#   EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
OPENAI_API_KEY=your-embedding-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# Discovery / Search
TAVILY_API_KEY=your-tavily-api-key

# Review inbox (SendClaw)
SENDCLAW_API_KEY=your-sendclaw-api-key

# Server Configuration
FLASK_PORT=8080
FLASK_HOST=0.0.0.0
FLASK_DEBUG=false

# Database Path (optional, defaults to local)
# DB_PATH=/path/to/library.db

# Logging Level
LOG_LEVEL=INFO
